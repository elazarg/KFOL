# Track Lean/TeX sources and their build essentials only. Overleaf GitHub sync
# limits the total editable content to 7 MB, including non-TeX text files.
*
!*/
!*.lean
!*.tex
!*.bib
!*.sty
!*.cls
!*.bst
!AGENTS.md
!/README
!/Makefile
!/.gitignore
!/lakefile.toml
!/lake-manifest.json
!/lean-toolchain
!/LICENSES/Apache-2.0.txt

# Auxiliary evidence and tools remain local; see README for their archive.
/scripts/*
!/scripts/export_labels.py
/notes/
/checks/
/verification/
/build/
/.lake/
__pycache__/
