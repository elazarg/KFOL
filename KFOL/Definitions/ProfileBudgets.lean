module

public import KFOL.Definitions.Equational
public import Mathlib.Data.Fintype.Basic

/-! # Simultaneous winner budgets and their single-absorber Horn closure -/

@[expose] public section
namespace KFOL.Core.ProfileBudgets
universe u v w
variable {Role : Type u} {Var : Type v} {Row : Type w}
attribute [local instance] Equational.coreStructure

/-- One valuation and its permitted winners. -/
structure Budget (Role : Type u) (Var : Type v) where
  values : Var → WinnerSet Role
  allowed : Set Role

/-- The term respects every prescribed winner budget simultaneously. -/
def Satisfies [DecidableEq Role] (b : Row → Budget Role Var)
    (t : Equational.Term (Equational.CoreSymbol Role) Var) : Prop :=
  ∀ i, (t.realize (b i).values).val ⊆ (b i).allowed

/-- Every allowed atomic input at every row belongs to the distinguished owner. -/
def SingleAbsorber (b : Row → Budget Role Var) (r : Role) : Prop :=
  ∀ i s, s ∈ (b i).allowed → s ≠ r → ∀ j,
    (b i).values j ≠ WinnerSet.singleton s

/-- A nonempty fold support respects all rows exactly when each row either
admits every selected input or has a selected, permitted absorbing atom. -/
def SafeSupport (b : Row → Budget Role Var) (r : Role) (S : Set Var) : Prop :=
  ∀ i, (∀ j ∈ S, ((b i).values j).val ⊆ (b i).allowed) ∨
    (r ∈ (b i).allowed ∧ ∃ j ∈ S, (b i).values j = WinnerSet.singleton r)

/-- The Horn rules on complements of safe supports. If the owner is permitted,
its whole atomic coalition forces all ineligible inputs; otherwise those
ineligible inputs are forced without a premise. -/
def BudgetClosed (b : Row → Budget Role Var) (r : Role) (T : Set Var) : Prop :=
  ∀ i, (r ∈ (b i).allowed → ∀ j, (b i).values j = WinnerSet.singleton r → j ∈ T) →
    ∀ j, ¬((b i).values j).val ⊆ (b i).allowed → j ∈ T

/-- The ordinary closure generated by the simultaneous budget Horn rules. -/
def budgetClosure (b : Row → Budget Role Var) (r : Role) (T : Set Var) : Set Var :=
  {j | ∀ C : Set Var, T ⊆ C → BudgetClosed b r C → j ∈ C}

/-- The greatest safe fold support contained in the given set. -/
def greatestSupport (b : Row → Budget Role Var) (r : Role) (D : Set Var) : Set Var :=
  (budgetClosure b r Dᶜ)ᶜ

/-- The direct simultaneous-budget test for a same-owner positive/negative pair. -/
def PairCondition [DecidableEq Role] (b : Row → Budget Role Var) (r q : Role)
    (A B : Var → Bool) : Prop :=
  if q = r then
    ∃ j ∈ greatestSupport b r {j | B j = false}, A j = true
  else ∃ j ∈ greatestSupport b r {j | A j = true}, B j = false

/-- The direct test for one positive coalition per requested owner. -/
def RainbowCondition (b : Row → Budget Role Var) (r : Role) (J : Finset Role)
    (A : Role → Var → Bool) : Prop :=
  ∃ j ∈ greatestSupport b r {j | ∀ q ∈ J, q ≠ r → A q j = true},
    r ∈ J → A r j = true

/-- Top bits, simultaneous pair separation, and simultaneous rainbow feasibility. -/
def ProfileCondition [DecidableEq Role] [Fintype Role] (b : Row → Budget Role Var) (r : Role)
    (Φ : Role → (Var → Bool) → Bool) : Prop :=
  (∀ q, Φ q (fun _ => true) = true) ∧
  (∀ q A B, Φ q A = true → Φ q B = false → PairCondition b r q A B) ∧
  ∀ A : Role → Var → Bool, (∀ q, Φ q (A q) = true) →
    RainbowCondition b r Finset.univ A

end KFOL.Core.ProfileBudgets
