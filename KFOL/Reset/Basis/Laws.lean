module

public import KFOL.Reset.Basic

/-! # Consequences of the six reset laws in arbitrary algebras

The equational calculations follow Freese et al., The variety generated by
order algebras (2002), introduction and Lemma 3.4. All imported results are
ordinary Lean equality and list facts; the published theorem is not assumed.
-/

@[expose] public section

namespace KFOL.Reset.Laws

universe u

variable {M : Type u} {op : M → M → M} (h : Laws op)

local infixl:70 " ⋄ " => op

include h

/-- Freese et al. (E6). -/
theorem e6 (x y : M) : x ⋄ (x ⋄ y) = x ⋄ y := by
  calc
    x ⋄ (x ⋄ y) = x ⋄ ((x ⋄ y) ⋄ y) := congrArg (op x) (h.repeat_right x y).symm
    _ = x ⋄ (y ⋄ y) := h.nested x y y
    _ = x ⋄ y := congrArg (op x) (h.idem y)

/-- Freese et al. (E7). -/
theorem e7 (x y z : M) : (x ⋄ y) ⋄ (y ⋄ z) = (x ⋄ y) ⋄ z := by
  calc
    (x ⋄ y) ⋄ (y ⋄ z) = (x ⋄ y) ⋄ (((x ⋄ y) ⋄ y) ⋄ z) := (h.nested _ _ _).symm
    _ = (x ⋄ y) ⋄ ((x ⋄ y) ⋄ z) := by rw [h.repeat_right]
    _ = (x ⋄ y) ⋄ z := h.e6 _ _

/-- Freese et al. (E8). -/
theorem e8 (x y z : M) : (x ⋄ (y ⋄ z)) ⋄ z = x ⋄ (y ⋄ z) := by
  symm
  calc
    x ⋄ (y ⋄ z) = (x ⋄ (y ⋄ z)) ⋄ (y ⋄ z) := (h.repeat_right _ _).symm
    _ = (x ⋄ (y ⋄ z)) ⋄ ((y ⋄ z) ⋄ z) := congrArg _ (h.repeat_right y z).symm
    _ = (x ⋄ (y ⋄ z)) ⋄ z := h.e7 x (y ⋄ z) z

/-- Freese et al. (E9). -/
theorem e9 (x y z : M) : (x ⋄ (y ⋄ z)) ⋄ y = (x ⋄ z) ⋄ y := by
  calc
    (x ⋄ (y ⋄ z)) ⋄ y = ((x ⋄ y) ⋄ (y ⋄ z)) ⋄ y := (h.exchange x y (y ⋄ z)).symm
    _ = ((x ⋄ y) ⋄ z) ⋄ y := by rw [h.e7]
    _ = (x ⋄ z) ⋄ y := h.exchange _ _ _

/-- Freese et al. (E10). -/
theorem e10 (x y z : M) : (x ⋄ y) ⋄ (z ⋄ y) = x ⋄ (z ⋄ y) := by
  calc
    (x ⋄ y) ⋄ (z ⋄ y) = ((x ⋄ y) ⋄ (z ⋄ y)) ⋄ y := (h.e8 _ _ _).symm
    _ = (x ⋄ (z ⋄ y)) ⋄ y := h.exchange _ _ _
    _ = x ⋄ (z ⋄ y) := h.e8 _ _ _

/-- Freese et al. (E11). -/
theorem e11 (x y : M) : x ⋄ (y ⋄ x) = y ⋄ x := by
  calc
    x ⋄ (y ⋄ x) = ((y ⋄ x) ⋄ x) ⋄ (y ⋄ x) := (h.absorb _ _).symm
    _ = (y ⋄ x) ⋄ (y ⋄ x) := by rw [h.repeat_right]
    _ = y ⋄ x := h.idem _

/-- Lemma 3.4(1). -/
theorem interlace (x y z u : M) : (x ⋄ ((y ⋄ z) ⋄ u)) ⋄ ((y ⋄ u) ⋄ z) = (x ⋄ (y ⋄ u)) ⋄ z := by
  calc
    (x ⋄ ((y ⋄ z) ⋄ u)) ⋄ ((y ⋄ u) ⋄ z) =
        (x ⋄ ((y ⋄ z) ⋄ u)) ⋄ (((y ⋄ z) ⋄ u) ⋄ z) := by rw [h.exchange y z u]
    _ = (x ⋄ ((y ⋄ z) ⋄ u)) ⋄ z := h.e7 _ _ _
    _ = ((y ⋄ z) ⋄ (x ⋄ u)) ⋄ z := by rw [h.left_comm x (y ⋄ z) u]
    _ = (y ⋄ (x ⋄ u)) ⋄ z := h.exchange _ _ _
    _ = (x ⋄ (y ⋄ u)) ⋄ z := by rw [h.left_comm y x u]

/-- Lemma 3.4(2), the path-normalization law. -/
theorem transport (x y z u : M) : (x ⋄ z) ⋄ ((y ⋄ z) ⋄ u) = (x ⋄ (y ⋄ z)) ⋄ u := by
  calc
    (x ⋄ z) ⋄ ((y ⋄ z) ⋄ u) =
        (x ⋄ z) ⋄ (((x ⋄ z) ⋄ (y ⋄ z)) ⋄ u) := (h.nested _ _ _).symm
    _ = (x ⋄ z) ⋄ ((x ⋄ (y ⋄ z)) ⋄ u) := by rw [h.e10]
    _ = (x ⋄ (y ⋄ z)) ⋄ ((x ⋄ z) ⋄ u) := h.left_comm _ _ _
    _ = ((x ⋄ ((x ⋄ z) ⋄ u)) ⋄ (y ⋄ z)) ⋄ ((x ⋄ z) ⋄ u) :=
      (h.exchange _ _ _).symm
    _ = ((x ⋄ (z ⋄ u)) ⋄ (y ⋄ z)) ⋄ ((x ⋄ z) ⋄ u) := by rw [h.nested]
    _ = (y ⋄ ((x ⋄ (z ⋄ u)) ⋄ z)) ⋄ ((x ⋄ z) ⋄ u) :=
      congrArg (fun q => q ⋄ ((x ⋄ z) ⋄ u)) (h.left_comm (x ⋄ (z ⋄ u)) y z)
    _ = (y ⋄ ((x ⋄ u) ⋄ z)) ⋄ ((x ⋄ z) ⋄ u) := by rw [h.e9]
    _ = (y ⋄ (x ⋄ z)) ⋄ u := h.interlace _ _ _ _
    _ = (x ⋄ (y ⋄ z)) ⋄ u := by rw [h.left_comm y x z]

/-- Right multiplication distributes over a product of two elements fixed by
one common right factor (Lemma 3.4(4)). -/
theorem distribute (a b r x : M) : ((a ⋄ r) ⋄ (b ⋄ r)) ⋄ x =
    ((a ⋄ r) ⋄ x) ⋄ ((b ⋄ r) ⋄ x) := by
  calc
    ((a ⋄ r) ⋄ (b ⋄ r)) ⋄ x = (a ⋄ (b ⋄ r)) ⋄ x := by rw [h.e10]
    _ = (a ⋄ r) ⋄ ((b ⋄ r) ⋄ x) := (h.transport _ _ _ _).symm
    _ = ((a ⋄ r) ⋄ x) ⋄ ((b ⋄ r) ⋄ x) := (h.e10 _ _ _).symm

/-- Common-right-factor multiplication is commutative. -/
theorem comm_of_fixed {r a b : M} (ha : a ⋄ r = a) (hb : b ⋄ r = b) : a ⋄ b = b ⋄ a := by
  simpa only [ha, hb] using h.left_comm a b r

/-- Common-right-factor multiplication is associative. -/
theorem assoc_of_fixed {r a b c : M} (ha : a ⋄ r = a) (hb : b ⋄ r = b) :
    a ⋄ (b ⋄ c) = (a ⋄ b) ⋄ c := by
  simpa only [ha, hb] using h.transport a b r c

/-- Right multiplication preserves common-right-factor products. -/
theorem distribute_of_fixed {r a b : M} (ha : a ⋄ r = a) (hb : b ⋄ r = b) (x : M) :
    (a ⋄ b) ⋄ x = (a ⋄ x) ⋄ (b ⋄ x) := by
  simpa only [ha, hb] using h.distribute a b r x

/-- The natural order is used as a relation, avoiding a global order instance. -/
def Below (a b : M) : Prop := a ⋄ b = a

variable {a b c : M}

theorem below_refl (a : M) : Below (op := op) a a := h.idem a

theorem below_trans (hab : Below (op := op) a b) (hbc : Below (op := op) b c) :
    Below (op := op) a c := by
  change a ⋄ c = a
  calc
    a ⋄ c = (a ⋄ b) ⋄ c := by rw [hab]
    _ = (a ⋄ b) ⋄ (b ⋄ c) := (h.e7 _ _ _).symm
    _ = (a ⋄ b) ⋄ b := by rw [hbc]
    _ = a := (h.repeat_right a b).trans hab

theorem below_antisymm (hab : Below (op := op) a b) (hba : Below (op := op) b a) : a = b := by
  change a ⋄ b = a at hab
  change b ⋄ a = b at hba
  have he := h.absorb a b
  simpa only [hab, hba, h.idem] using he

theorem op_below_right (a b : M) : Below (op := op) (a ⋄ b) b := h.repeat_right a b

theorem below_op_left (hab : Below (op := op) a b) (c : M) : Below (op := op) (a ⋄ c) (b ⋄ c) := by
  change (a ⋄ c) ⋄ (b ⋄ c) = a ⋄ c
  calc
    (a ⋄ c) ⋄ (b ⋄ c) = a ⋄ (b ⋄ c) := h.e10 _ _ _
    _ = a ⋄ ((a ⋄ b) ⋄ c) := (h.nested _ _ _).symm
    _ = a ⋄ (a ⋄ c) := by rw [hab]
    _ = a ⋄ c := h.e6 _ _

theorem reassoc_below (a b c : M) : Below (op := op) (a ⋄ (b ⋄ c)) ((a ⋄ b) ⋄ c) := by
  change (a ⋄ (b ⋄ c)) ⋄ ((a ⋄ b) ⋄ c) = a ⋄ (b ⋄ c)
  calc
    (a ⋄ (b ⋄ c)) ⋄ ((a ⋄ b) ⋄ c) =
        (a ⋄ ((a ⋄ b) ⋄ c)) ⋄ ((a ⋄ b) ⋄ c) := by rw [h.nested]
    _ = a ⋄ ((a ⋄ b) ⋄ c) := h.repeat_right _ _
    _ = a ⋄ (b ⋄ c) := h.nested _ _ _

/-- A simultaneous lower bound lies below the product. -/
theorem below_op (hab : Below (op := op) a b) (hac : Below (op := op) a c) :
    Below (op := op) a (b ⋄ c) := by
  change a ⋄ (b ⋄ c) = a
  calc
    a ⋄ (b ⋄ c) = a ⋄ ((a ⋄ b) ⋄ c) := (h.nested _ _ _).symm
    _ = a ⋄ (a ⋄ c) := by rw [hab]
    _ = a ⋄ c := h.e6 _ _
    _ = a := hac

end KFOL.Reset.Laws
