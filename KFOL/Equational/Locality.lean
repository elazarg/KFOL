module

public import KFOL.Equational.Preservation

/-!
# Transfer from subalgebras generated by few values

The number of generators is the number of distinct variables actually used,
not the identity's padded arity. Nullary identities are handled using a ground
term to inhabit the generated subalgebra; an empty core closure is never
silently assumed to belong to a nonempty equational variety.
-/

@[expose] public section

namespace KFOL.Equational

universe u v w

open FirstOrder

variable {σ : ℕ → Type u} {M : Type v} [(language σ).Structure M]

/-- Realization depends only on the variables occurring in the term. -/
theorem realize_eq_of_eqOn {Var : Type*} [DecidableEq Var] (t : Term σ Var)
    (v w : Var → M) (h : ∀ x ∈ t.varFinset, v x = w x) : t.realize v = t.realize w := by
  induction t with
  | var x => exact h x (by simp)
  | @func n f args ih =>
    change Language.Structure.funMap (L := language σ) f (fun i => (args i).realize v) = _
    congr 1
    funext i
    apply ih i
    intro x hx
    exact h x (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hx⟩)

/-- A small-support identity transfers from the corresponding generated
subalgebras. The nonemptiness premise is proved even for zero generators. -/
theorem Identity.holds_of_generated (e : Identity σ) (n : ℕ) (hn : e.variableCount ≤ n)
    (hlocal : ∀ X : Finset M, X.card ≤ n →
      Nonempty (Language.Substructure.closure (language σ) (X : Set M)) →
      e.Holds (Language.Substructure.closure (language σ) (X : Set M))) : e.Holds M := by
  classical
  intro v
  let X := e.support.image v
  let S := Language.Substructure.closure (language σ) (X : Set M)
  have hmem (i : e.support) : v i.val ∈ S :=
    Language.Substructure.subset_closure (Finset.mem_image.mpr ⟨i.val, i.property, rfl⟩)
  let small : e.support → S := fun i => ⟨v i.val, hmem i⟩
  let reduced : Term σ e.support := e.lhs.restrictVar
    (fun i => ⟨i.val, Finset.mem_union_left _ i.property⟩)
  let fallback : S := reduced.realize small
  let lifted : Fin e.arity → S := fun i =>
    if hi : i ∈ e.support then ⟨v i, hmem ⟨i, hi⟩⟩ else fallback
  have hlift : ∀ i ∈ e.support, (lifted i).val = v i := by
    intro i hi
    simp [lifted, hi]
  have hX : X.card ≤ n := Finset.card_image_le.trans hn
  have he := congrArg (fun x : S => x.val) (hlocal X hX ⟨fallback⟩ lifted)
  have eval_subtype (t : Term σ (Fin e.arity)) :
      ((t.realize lifted : S) : M) = t.realize (fun i => (lifted i).val) :=
    (Language.HomClass.realize_term S.subtype.toHom).symm
  rw [eval_subtype, eval_subtype] at he
  rw [realize_eq_of_eqOn e.lhs _ v (fun i hi => hlift i (Finset.mem_union_left _ hi)),
    realize_eq_of_eqOn e.rhs _ v (fun i hi => hlift i (Finset.mem_union_right _ hi))] at he
  exact he

/-- Local membership gives every generator identity within the support bound. -/
theorem Identity.holds_of_local_variety {A : Type w} [(language σ).Structure A]
    (e : Identity σ) (n : ℕ) (hn : e.variableCount ≤ n) (hA : e.Holds A)
    (hlocal : ∀ X : Finset M, X.card ≤ n →
      Nonempty (Language.Substructure.closure (language σ) (X : Set M)) →
      InVariety σ A (Language.Substructure.closure (language σ) (X : Set M))) : e.Holds M :=
  e.holds_of_generated n hn (fun X hX hne => (hlocal X hX hne).2 e hA)

/-- The final logical reduction in a finite-countermodel nonfinite-basis proof.
Constructing such countermodels for the owned-choice core remains separate. -/
theorem not_hasFiniteBasis_of_bounded_countermodels {A : Type v} [(language σ).Structure A]
    (counter : ∀ n : ℕ, ∃ (B : Type w) (str : (language σ).Structure B),
      Nonempty B ∧ Finite B ∧
      (∀ e : Identity σ, e.variableCount ≤ n → e.Holds A → @Identity.Holds σ e B str) ∧
      ¬@InVariety σ A B inferInstance str) : ¬HasFiniteBasis σ A := by
  rintro ⟨T, hT, hbasis⟩
  obtain ⟨n, hn⟩ := finite_hasVariableBound T hT
  obtain ⟨B, str, hne, _, hsmall, hnot⟩ := counter n
  let _ := str
  let _ := hne
  have hB : Models T B := fun e he => hsmall e (hn e he) (hbasis.models e he)
  exact hnot (hbasis.inVariety hB)

end KFOL.Equational
