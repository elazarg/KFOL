module

public import KFOL.Core.ModelLaws

/-! # Separation of winner values by native omission quotients -/

@[expose] public section

namespace KFOL.Core.Native

universe u v

open FirstOrder

variable {Role : Type u} [DecidableEq Role] {Var : Type v}

attribute [local instance] structureOf Equational.coreStructure

/-- The omission map viewed in the common native superalgebra. -/
noncomputable def quotientToNative (drop : Option Role) :
    WinnerSet Role →[Equational.language (Equational.CoreSymbol Role)] Native Role :=
  (omission drop).subtype.toHom.comp (quotientHom drop)

@[simp] theorem quotientToNative_apply (drop : Option Role) (x : WinnerSet Role) :
    quotientToNative drop x = quotient drop x := rfl

/-- Every full-native identity also holds in the original winner algebra:
the omitted-role quotients detect each membership bit independently. -/
theorem winner_equation_of_native
    (s t : Equational.Term (Equational.CoreSymbol Role) Var)
    (h : ∀ v : Var → Native Role, s.realize v = t.realize v)
    (v : Var → WinnerSet Role) : s.realize v = t.realize v := by
  apply Subtype.ext
  apply Set.ext
  intro k
  let f := quotientToNative (Role := Role) (some k)
  have he : f (s.realize v) = f (t.realize v) := by
    rw [← Language.HomClass.realize_term f, ← Language.HomClass.realize_term f]
    exact h _
  have he' : quotient (some k) (s.realize v) = quotient (some k) (t.realize v) := he
  have hs : quotient (some k) (s.realize v) = Native.upper ↔ k ∈ (s.realize v).val := by
    simp only [quotient_eq_upper, Option.some.injEq]
    exact ⟨fun ⟨l,hl,hm⟩ => hl ▸ hm, fun hm => ⟨k,rfl,hm⟩⟩
  have ht : quotient (some k) (t.realize v) = Native.upper ↔ k ∈ (t.realize v).val := by
    simp only [quotient_eq_upper, Option.some.injEq]
    exact ⟨fun ⟨l,hl,hm⟩ => hl ▸ hm, fun hm => ⟨k,rfl,hm⟩⟩
  exact hs.symm.trans ((congrArg (fun x : Native Role => x = Native.upper) he').to_iff.trans ht)

/-- The original winner algebra belongs to the variety generated by the
full native algebra, independently of any attempted reverse inclusion. -/
theorem winner_inVariety [Nonempty Role] :
    Equational.InVariety (Equational.CoreSymbol Role) (Native Role) (WinnerSet Role) := by
  refine ⟨⟨WinnerSet.singleton (Classical.choice (inferInstance : Nonempty Role))⟩, ?_⟩
  intro e he v
  exact winner_equation_of_native e.lhs e.rhs he v

end KFOL.Core.Native
