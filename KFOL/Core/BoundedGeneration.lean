module

public import KFOL.Definitions.CoreInterpolation
public import KFOL.Definitions.Core
public import KFOL.Algebra.Basic
public import Mathlib.Data.Fintype.Powerset
public import Mathlib.Data.Fintype.Pi

/-! # Boundary generators for bounded core evaluations

A bounded output tuple either decomposes into two bounded child tuples, or
is atomic at a constrained row. Thus all bounded tuples are generated by
bounded projections and realizable tuples atomic at a constrained row.
-/

@[expose] public section

namespace KFOL.Core.Interpolation

universe u v w
variable {Role : Type u} {Row : Type v} {Var : Type w}

/-- Implementation carrier for the boundary-generation proof. Each value is
bounded and is either a projection or a realizable atomic boundary tuple. -/
abbrev BoundaryGenerator (values : Row → Var → WinnerSet Role)
    (N : Finset Row) (U : Row → Set Role) :=
  {x : Row → WinnerSet Role // Bounded N U x ∧
    ((∃ j, ∀ i, x i = values i j) ∨
      (∃ t : Term Role Var, t.IsCore ∧ ∀ i, t.eval (values i) = x i) ∧
        ∃ i ∈ N, ∃ r, x i = WinnerSet.singleton r)}

instance [Finite Row] [Finite Role] (values : Row → Var → WinnerSet Role)
    (N : Finset Row) (U : Row → Set Role) :
    Finite (BoundaryGenerator values N U) := by
  classical
  let _ := Fintype.ofFinite Role
  let _ := Fintype.ofFinite Row
  infer_instance

theorem boundary_bounded {values : Row → Var → WinnerSet Role}
    {N : Finset Row} {U : Row → Set Role} (g : BoundaryGenerator values N U) :
    Bounded N U g.val := g.property.1

theorem boundary_projection_or_atomic {values : Row → Var → WinnerSet Role}
    {N : Finset Row} {U : Row → Set Role} (g : BoundaryGenerator values N U) :
    (∃ j, ∀ i, g.val i = values i j) ∨
      ∃ i ∈ N, ∃ r, g.val i = WinnerSet.singleton r := by
  exact g.property.2.elim Or.inl (fun h => Or.inr h.2)

theorem boundary_realizer {values : Row → Var → WinnerSet Role}
    {N : Finset Row} {U : Row → Set Role} (g : BoundaryGenerator values N U) :
    ∃ t : Term Role Var, t.IsCore ∧ ∀ i, t.eval (values i) = g.val i := by
  rcases g.property.2 with ⟨j, hj⟩ | ⟨ht, _⟩
  · exact ⟨.var j, trivial, fun i => (hj i).symm⟩
  · exact ht

private theorem atomic_of_unbounded_children (N : Finset Row) (U : Row → Set Role)
    (r : Role) (x y : Row → WinnerSet Role)
    (hb : Bounded N U (fun i => WinnerSet.choice r (x i) (y i)))
    (hchildren : ¬(Bounded N U x ∧ Bounded N U y)) :
    ∃ i ∈ N, WinnerSet.choice r (x i) (y i) = WinnerSet.singleton r := by
  classical
  by_contra hn
  have hsubset (i : Row) (hi : i ∈ N) :
      (x i).val ⊆ U i ∧ (y i).val ⊆ U i := by
    have hno : ¬(x i = WinnerSet.singleton r ∨ y i = WinnerSet.singleton r) := by
      intro h
      exact hn ⟨i, hi, by simp [WinnerSet.choice, h]⟩
    have he : WinnerSet.choice r (x i) (y i) = (x i).union (y i) := by
      simp [WinnerSet.choice, hno]
    have hh := hb i hi
    change (WinnerSet.choice r (x i) (y i)).val ⊆ U i at hh
    rw [he] at hh
    exact ⟨fun _ h => hh (Or.inl h), fun _ h => hh (Or.inr h)⟩
  exact hchildren ⟨fun i hi => (hsubset i hi).1, fun i hi => (hsubset i hi).2⟩

/-- All row outputs of a bounded core evaluation are generated by its bounded
projection and atomic-boundary tuples. No finiteness assumption is needed. -/
theorem bounded_generated_by_boundary (values : Row → Var → WinnerSet Role)
    (N : Finset Row) (U : Row → Set Role) (t : Term Role Var) (ht : t.IsCore)
    (hb : Bounded N U (fun i => t.eval (values i))) :
    ∃ s : Term Role (BoundaryGenerator values N U), s.IsCore ∧
      ∀ i, s.eval (fun g => g.val i) = t.eval (values i) := by
  classical
  induction t with
  | winner => exact ht.elim
  | rename => exact ht.elim
  | var j =>
    let g : BoundaryGenerator values N U :=
      ⟨fun i => values i j, hb, Or.inl ⟨j, fun _ => rfl⟩⟩
    exact ⟨.var g, trivial, fun _ => rfl⟩
  | choice r t u iht ihu =>
    by_cases hc : Bounded N U (fun i => t.eval (values i)) ∧
        Bounded N U (fun i => u.eval (values i))
    · obtain ⟨s, hs, hse⟩ := iht ht.1 hc.1
      obtain ⟨z, hz, hze⟩ := ihu ht.2 hc.2
      exact ⟨.choice r s z, ⟨hs, hz⟩, by intro i; simp only [Term.eval, hse, hze]⟩
    · obtain ⟨i, hi, ha⟩ := atomic_of_unbounded_children N U r _ _ hb hc
      let g : BoundaryGenerator values N U :=
        ⟨fun i => (Term.choice r t u).eval (values i), hb,
          Or.inr ⟨⟨.choice r t u, ht, fun _ => rfl⟩, ⟨i, hi, r, ha⟩⟩⟩
      exact ⟨.var g, trivial, fun _ => rfl⟩

private theorem boundary_term_realizer (values : Row → Var → WinnerSet Role)
    (N : Finset Row) (U : Row → Set Role)
    (s : Term Role (BoundaryGenerator values N U)) (hs : s.IsCore) :
    ∃ t : Term Role Var, t.IsCore ∧ Bounded N U (fun i => t.eval (values i)) ∧
      ∀ i, t.eval (values i) = s.eval (fun g => g.val i) := by
  induction s with
  | winner => exact hs.elim
  | rename => exact hs.elim
  | var g =>
    obtain ⟨t, ht, he⟩ := boundary_realizer g
    refine ⟨t, ht, ?_, he⟩
    intro i hi
    change (t.eval (values i)).val ⊆ U i
    rw [he]
    exact boundary_bounded g i hi
  | choice r s z ihs ihz =>
    obtain ⟨t, ht, hbt, hte⟩ := ihs hs.1
    obtain ⟨u, hu, hbu, hue⟩ := ihz hs.2
    refine ⟨.choice r t u, ⟨ht, hu⟩, ?_, ?_⟩
    · intro i hi k hk
      exact (WinnerSet.choice_subset_union r _ _ hk).elim
        (fun h => hbt i hi h) (fun h => hbu i hi h)
    · intro i
      simp only [Term.eval, hte, hue]

/-- Bounded simultaneous interpolation is exactly core interpolation over the
bounded projection and atomic-boundary generator carrier. -/
theorem boundary_generated_iff (values : Row → Var → WinnerSet Role)
    (N : Finset Row) (U : Row → Set Role) (target : Row → WinnerSet Role) :
    (∃ t : Term Role Var, t.IsCore ∧ Bounded N U (fun i => t.eval (values i)) ∧
      ∀ i, t.eval (values i) = target i) ↔
    ∃ s : Term Role (BoundaryGenerator values N U), s.IsCore ∧
      ∀ i, s.eval (fun g => g.val i) = target i := by
  constructor
  · rintro ⟨t, ht, hb, he⟩
    obtain ⟨s, hs, hse⟩ := bounded_generated_by_boundary values N U t ht hb
    exact ⟨s, hs, fun i => (hse i).trans (he i)⟩
  · rintro ⟨s, hs, hse⟩
    obtain ⟨t, ht, hb, he⟩ := boundary_term_realizer values N U s hs
    exact ⟨t, ht, hb, fun i => (he i).trans (hse i)⟩

end KFOL.Core.Interpolation
