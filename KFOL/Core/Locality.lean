module

public import KFOL.Core.Quotients

/-! # The uniform K-variable native obstruction: local variety membership -/

@[expose] public section

namespace KFOL.Core.Native

universe u

open FirstOrder

variable {Role : Type u} [DecidableEq Role]

attribute [local instance] structureOf Equational.coreStructure

omit [DecidableEq Role] in
/-- The native carrier is uniformly atoms plus two markers, not an
enumerated special case for a fixed number of roles. -/
def equivOption : Native Role ≃ Option (Option Role) where
  toFun
    | .atom r => some (some r)
    | .lower => some none
    | .upper => none
  invFun
    | some (some r) => .atom r
    | some none => .lower
    | none => .upper
  left_inv x := by cases x <;> rfl
  right_inv x := by cases x with
    | none => rfl
    | some x => cases x <;> rfl

omit [DecidableEq Role] in
instance [Fintype Role] : Fintype (Native Role) := Fintype.ofEquiv _ equivOption.symm

omit [DecidableEq Role] in
theorem card_native [Fintype Role] : Fintype.card (Native Role) = Fintype.card Role + 2 := by
  rw [Fintype.card_congr equivOption, Fintype.card_option, Fintype.card_option]

omit [DecidableEq Role] in
theorem omitted_injective : Function.Injective (@omitted Role) := by
  intro x y he
  cases x <;> cases y <;> simp_all [omitted]

/-- At most K arbitrary values miss one of the K+1 distinguished elements:
the K atoms and the upper marker. The lower marker is not counted. -/
theorem exists_omission [Fintype Role] (X : Finset (Native Role))
    (hX : X.card ≤ Fintype.card Role) : ∃ drop : Option Role, omitted drop ∉ X := by
  classical
  by_contra hn
  push Not at hn
  have hsub : (Finset.univ.image (@omitted Role)) ⊆ X := by
    intro x hx
    obtain ⟨drop, _, rfl⟩ := Finset.mem_image.mp hx
    exact hn drop
  have hc := Finset.card_le_card hsub
  rw [Finset.card_image_of_injective _ omitted_injective, Finset.card_univ,
    Fintype.card_option] at hc
  omega

/-- Every subalgebra generated by at most K arbitrary native values lies
in the winner-set core variety. Coefficients need not be named atoms. -/
theorem generated_inVariety [Fintype Role] (three : Fin 3 ↪ Role)
    (X : Finset (Native Role)) (hX : X.card ≤ Fintype.card Role)
    (hne : Nonempty (FirstOrder.Language.Substructure.closure
      (Equational.language (Equational.CoreSymbol Role)) (X : Set (Native Role)))) :
    Equational.InVariety (Equational.CoreSymbol Role) (WinnerSet Role)
      (FirstOrder.Language.Substructure.closure
        (Equational.language (Equational.CoreSymbol Role)) (X : Set (Native Role))) := by
  obtain ⟨drop, hdrop⟩ := exists_omission X hX
  let S := FirstOrder.Language.Substructure.closure
    (Equational.language (Equational.CoreSymbol Role)) (X : Set (Native Role))
  have hs : S ≤ omission drop := FirstOrder.Language.Substructure.closure_le.mpr (by
    intro x hx
    change x ≠ omitted drop
    intro he
    exact hdrop (he ▸ hx))
  let f : S →[Equational.language (Equational.CoreSymbol Role)] (omission drop) :=
    { toFun x := ⟨x.val, hs x.property⟩
      map_fun' := by intro n f args; rfl
      map_rel' := by intro n r; exact nomatch r }
  have : Nonempty S := hne
  exact Equational.InVariety.of_injective (omission_inVariety three drop) f (by
    intro x y h
    have hv : x.val = y.val := congrArg (fun z : omission drop => z.val) h
    exact Subtype.ext hv)

/-- Transfer all identities with at most K actual variables, with no term
size cutoff and regardless of padded declared arity. -/
theorem holds_of_variableCount_le [Fintype Role] (three : Fin 3 ↪ Role)
    (e : Equational.Identity (Equational.CoreSymbol Role))
    (he : e.variableCount ≤ Fintype.card Role) (hv : e.Holds (WinnerSet Role)) :
    e.Holds (Native Role) :=
  e.holds_of_local_variety (Fintype.card Role) he hv (generated_inVariety three)

end KFOL.Core.Native
