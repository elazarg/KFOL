module

public import Mathlib.Data.Set.Finite.Basic
public import Mathlib.Data.Fintype.Powerset
public import Mathlib.Data.Set.Lattice.Order
public import Mathlib.Order.Minimal

/-! # Distributivity of the lattice of unions of bipartite neighborhoods -/

@[expose] public section
namespace KFOL.Core.NeighborhoodLattice

variable {X Y : Type*} (E : X → Y → Prop)

/-- Each point of the set has a row neighborhood contained in it. -/
def IsRowUnion (U : Set Y) : Prop :=
  ∀ y ∈ U, ∃ x, E x y ∧ {z | E x z} ⊆ U

/-- Row unions, ordered by inclusion. -/
abbrev RowUnion := {U : Set Y // IsRowUnion E U}

def ofRows (S : Set X) : RowUnion E :=
  ⟨{y | ∃ x ∈ S, E x y}, fun _ ⟨x, hx, e⟩ => ⟨x, e, fun _ e' => ⟨x, hx, e'⟩⟩⟩

def row (x : X) : RowUnion E :=
  ⟨{y | E x y}, fun _ e => ⟨x, e, Set.Subset.rfl⟩⟩

theorem ofRows_surjective : Function.Surjective (ofRows E) := by
  intro U
  refine ⟨{x | row E x ≤ U}, Subtype.ext ?_⟩
  ext y
  exact ⟨fun ⟨_, sub, e⟩ => sub e, fun hy =>
    let ⟨x, e, sub⟩ := U.property y hy
    ⟨x, sub, e⟩⟩

instance [Finite X] : Finite (RowUnion E) := Finite.of_surjective _ (ofRows_surjective E)

/-- The largest row union inside a set, used to take meets. -/
def interior (U : Set Y) : RowUnion E := ofRows E {x | {y | E x y} ⊆ U}

theorem interior_le (U : Set Y) : (interior E U).val ⊆ U := fun _ ⟨_, sub, e⟩ => sub e

theorem le_interior {U : RowUnion E} {A : Set Y} (sub : U.val ⊆ A) : U ≤ interior E A := by
  intro y hy
  obtain ⟨x, e, hx⟩ := U.property y hy
  exact ⟨x, hx.trans sub, e⟩

def join (U V : RowUnion E) : RowUnion E := by
  refine ⟨U.val ∪ V.val, ?_⟩
  intro y hy
  rcases hy with hy | hy
  · obtain ⟨x, e, hx⟩ := U.property y hy
    exact ⟨x, e, hx.trans Set.subset_union_left⟩
  · obtain ⟨x, e, hx⟩ := V.property y hy
    exact ⟨x, e, hx.trans Set.subset_union_right⟩

instance : Lattice (RowUnion E) where
  sup := join E
  le_sup_left _ _ := Set.subset_union_left
  le_sup_right _ _ := Set.subset_union_right
  sup_le _ _ _ := Set.union_subset
  inf U V := interior E (U.val ∩ V.val)
  inf_le_left _ _ := (interior_le E _).trans Set.inter_subset_left
  inf_le_right _ _ := (interior_le E _).trans Set.inter_subset_right
  le_inf _ _ _ hu hv := le_interior E (Set.subset_inter hu hv)

@[simp] theorem val_sup (U V : RowUnion E) : (U ⊔ V).val = U.val ∪ V.val := rfl

@[simp] theorem ofRows_insert (S : Set X) (x : X) :
    ofRows E (insert x S) = row E x ⊔ ofRows E S := by
  apply Subtype.ext
  ext y
  change (∃ z ∈ insert x S, E z y) ↔ E x y ∨ ∃ z ∈ S, E z y
  simp

/-- Every lower bound on a join splits along its two summands. -/
def Refines : Prop :=
  ∀ U V W : RowUnion E, U ≤ V ⊔ W → ∃ V' W' : RowUnion E, V' ≤ V ∧ W' ≤ W ∧ U = V' ⊔ W'

/-- An edge whose two neighborhoods span a complete bipartite subgraph. -/
def Bisimplicial (b : X) (a : Y) : Prop :=
  E b a ∧ ∀ x, E x a → ∀ y, E b y → E x y

/-- Each edge belongs to a rectangle generated by some bisimplicial edge. -/
def EdgeCover : Prop :=
  ∀ x y, E x y → ∃ b a, Bisimplicial E b a ∧ E x a ∧ E b y

private theorem prime_of_refinement (refine : Refines E) (b : X) (y : Y) (ey : E b y)
    (minimal : ∀ U : RowUnion E, y ∈ U.val → U ≤ row E b → row E b ≤ U)
    (V W : RowUnion E) (sub : row E b ≤ V ⊔ W) : row E b ≤ V ∨ row E b ≤ W := by
  obtain ⟨V', W', hv, hw, eq⟩ := refine _ V W sub
  have yr : y ∈ (row E b).val := ey
  rw [eq, val_sup] at yr
  rcases yr with yr | yr
  · exact Or.inl ((minimal V' yr (eq ▸ le_sup_left)).trans hv)
  · exact Or.inr ((minimal W' yr (eq ▸ le_sup_right)).trans hw)

private theorem prime_ofRows (p : RowUnion E) (point : p.val.Nonempty)
    (prime : ∀ V W : RowUnion E, p ≤ V ⊔ W → p ≤ V ∨ p ≤ W) (S : Finset X) :
    p ≤ ofRows E (S : Set X) → ∃ x ∈ S, p ≤ row E x := by
  classical
  induction S using Finset.induction with
  | empty =>
    intro sub
    obtain ⟨y, hy⟩ := point
    obtain ⟨x, hx, _⟩ := sub hy
    simp at hx
  | insert x S _ ih =>
    intro sub
    rw [Finset.coe_insert, ofRows_insert] at sub
    rcases prime _ _ sub with yes | tail
    · exact ⟨x, Finset.mem_insert_self _ _, yes⟩
    · obtain ⟨z, hz, yes⟩ := ih tail
      exact ⟨z, Finset.mem_insert_of_mem hz, yes⟩

theorem edgeCover_of_refines [Finite X] (refine : Refines E) : EdgeCover E := by
  classical
  intro x y e
  obtain ⟨P, bx, least⟩ := exists_minimal_le_of_wellFoundedLT
    (fun U : RowUnion E => y ∈ U.val) (row E x) e
  obtain ⟨b, yb, sub⟩ := P.property y least.prop
  have beq : row E b = P := least.eq_of_le (show y ∈ (row E b).val from yb) sub
  subst P
  have minimal (U : RowUnion E) (yu : y ∈ U.val) (ub : U ≤ row E b) : row E b ≤ U :=
    least.le_of_le yu ub
  have prime := prime_of_refinement E refine b y yb minimal
  let bad := {z | ¬ row E b ≤ row E z}
  have outside : ¬ (row E b).val ⊆ (ofRows E bad).val := by
    intro sub
    have hsub : row E b ≤ ofRows E (bad.toFinite.toFinset : Set X) := by simpa using sub
    obtain ⟨z, hz, bz⟩ := prime_ofRows E (row E b) ⟨y, yb⟩ prime _ hsub
    exact (bad.toFinite.mem_toFinset.mp hz) bz
  obtain ⟨a, ab, avoid⟩ := Set.not_subset.mp outside
  refine ⟨b, a, ⟨ab, ?_⟩, bx ab, yb⟩
  intro z za v bv
  have bz : row E b ≤ row E z := by
    by_contra h
    exact avoid ⟨z, h, za⟩
  exact bz bv

/-- A covering rectangle refines a row union point by point. This direction
holds for arbitrary row and column sets. -/
theorem refines_of_edgeCover (cover : EdgeCover E) : Refines E := by
  intro U V W sub
  refine ⟨U ⊓ V, U ⊓ W, inf_le_right, inf_le_right, le_antisymm ?_ (sup_le inf_le_left inf_le_left)⟩
  intro y hy
  obtain ⟨x, xy, xu⟩ := U.property y hy
  obtain ⟨b, a, rect, xa, by'⟩ := cover x y xy
  have lift (Z : RowUnion E) (az : a ∈ Z.val) : y ∈ (U ⊓ Z).val := by
    obtain ⟨z, za, zz⟩ := Z.property a az
    exact ⟨b, fun v bv => ⟨xu (rect.2 x xa v bv), zz (rect.2 z za v bv)⟩, by'⟩
  exact (sub (xu xa)).elim (fun av => Or.inl (lift V av)) (fun aw => Or.inr (lift W aw))

theorem refines_iff_edgeCover [Finite X] : Refines E ↔ EdgeCover E :=
  ⟨edgeCover_of_refines E, refines_of_edgeCover E⟩

/-- Ordinary lattice distributivity is exactly coverage by bisimplicial rectangles. -/
theorem distributive_iff_edgeCover [Finite X] :
    (∀ U V W : RowUnion E, U ⊓ (V ⊔ W) = (U ⊓ V) ⊔ (U ⊓ W)) ↔ EdgeCover E := by
  rw [← refines_iff_edgeCover]
  constructor
  · intro dist U V W sub
    exact ⟨U ⊓ V, U ⊓ W, inf_le_right, inf_le_right, (inf_eq_left.mpr sub).symm.trans (dist U V W)⟩
  · intro refine U V W
    obtain ⟨A, B, av, bw, eq⟩ := refine (U ⊓ (V ⊔ W)) V W inf_le_right
    have au : A ≤ U := (show A ≤ U ⊓ (V ⊔ W) from eq ▸ le_sup_left).trans inf_le_left
    have bu : B ≤ U := (show B ≤ U ⊓ (V ⊔ W) from eq ▸ le_sup_right).trans inf_le_left
    apply le_antisymm
    · rw [eq]
      exact sup_le ((le_inf au av).trans le_sup_left) ((le_inf bu bw).trans le_sup_right)
    · exact sup_le (inf_le_inf_left _ le_sup_left) (inf_le_inf_left _ le_sup_right)

end KFOL.Core.NeighborhoodLattice
